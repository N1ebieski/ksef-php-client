{
    "name": "n1ebieski/ksef-php-client",
    "description": "PHP API client that allows you to interact with the API Krajowego Systemu e-Faktur",
    "keywords": [
        "ksef",
        "krajowy system e-faktur",
        "ksef php",
        "ksef php client"
    ],
    "version": "2.0.0-rc.1",
    "license": "MIT",
    "authors": [
        {
            "name": "Mariusz Wysokiński",
            "homepage": "https://intelekt.net.pl",            
            "email": "kontakt@intelekt.net.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4.0",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "php-http/discovery": "^1.20.0",
        "psr/http-client": "^1.0.3",
        "psr/http-client-implementation": "^1.0.1",
        "psr/http-factory-implementation": "^1.2",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0",
        "cuyz/valinor": "^2.0",
        "krowinski/bcmath-extended": "^8.0",
        "phpseclib/phpseclib": "^4.0",
        "psr-discovery/discovery": "^1.2",
        "psr-discovery/log-implementations": "^1.1"
    },
    "require-dev": {
        "endroid/qr-code": "^6.1", 
        "vlucas/phpdotenv": "^5.7",
        "guzzlehttp/guzzle": "^8.2",
        "guzzlehttp/psr7": "^3.1",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6",
        "monolog/monolog": "^3.12",
        "dg/bypass-finals": "^1.11",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-drift": "^5.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "symfony/cache": "^8.1",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-rector": "^5.0"
    },
    "suggest": {
        "endroid/qr-code": "^6.1 - Enables QR code generation through EndroidV6QRCodeGenerator",
        "n1ebieski/ksef-pdf-generator": "Fork the official MF KSeF PDF Generator with CLI generation support and offline invoices/transaction confirmations"
    },
    "autoload": {
        "psr-4": {
            "N1ebieski\\KSEFClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "N1ebieski\\KSEFClient\\Tests\\": "tests/"
        }
    },    
    "config": {
        "allow-plugins": {
            "php-http/discovery": false,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "build": [
            "Composer\\Config::disableProcessTimeout",
            "bash ./bin/build.sh"
        ],
        "phpstan": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpstan analyse > var/logs/phpstan.log"
        ],
        "cs-fixer": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/php-cs-fixer fix --allow-unsupported-php-version=yes"
        ],
        "rector": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/rector process"
        ],
        "rector:dry": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/rector process --dry-run > var/logs/rector.log"
        ],
        "pest": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/pest --parallel | tee var/logs/pest.log"
        ]
    }
}
