includes:
	- vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
	level: 10
	phpVersion: 80400
	stubFiles:
		- vendor/pestphp/pest/src/Mixins/Expectation.php
		- _ide_helper.php
	paths:
		- src/
		- bin/
		- tests/
	universalObjectCratesClasses:
		- N1ebieski\KSEFClient\Contracts\ContextInterface
		- N1ebieski\KSEFClient\Contracts\ValueAwareInterface
		- N1ebieski\KSEFClient\Contracts\HttpClient\ResponseInterface
		- N1ebieski\KSEFClient\Testing\Fixtures\AbstractFixture
		- N1ebieski\KSEFClient\Testing\Fixtures\Requests\AbstractResponseFixture
		- N1ebieski\KSEFClient\Testing\Fixtures\DTOs\Requests\Sessions\FakturaAbstractFixture
	excludePaths:
		- ./src/Overrides/Rector/Php74/Rector/Closure/ClosureToArrowFunctionRector.php
		- ./src/Testing/Fixtures

	ignoreErrors:
		- '#^Parameter \#1 \$node of method DOMDocument::importNode\(\) expects DOMNode, DOMElement\|null given.$#'
		- '#^Parameter \#1 \$data of static method ([a-zA-Z0-9\\]+)::normalizeXmlArray\(\) expects array<string, mixed>, mixed given\.$#'
		- '#^Parameter \#1 \$exception of method Pest\\Mixins\\Expectation<Closure>::toThrow\(\) expects \(Closure\(Throwable\): mixed\)\|string\|Throwable, Closure\([a-zA-Z0-9_\\\\]+\): void given\.$#'
		-
			message: '#^Cannot access offset ([a-zA-Z0-9@''_]+) on (mixed|array)#'
			path: tests/Unit/Actions/ConvertXmlToArray/ConvertXmlToArrayHandlerTest.php
		-
			message: '#^Cannot access offset ([a-zA-Z0-9@''_]+) on (mixed|array)#'
			path: tests/Unit/DTOs/Requests/Sessions/*
